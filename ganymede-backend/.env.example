# Ganymede backend — .env template (copy to .env, which is gitignored).
# Authored at SM-0 of the substrate migration (2026-07-02); documents the
# DORMANT-NotebookLM configuration this machine runs.
# Full plan: docs/concepts/Substrate_Migration.md

# ── Substrate (SM-1+ reads this; harmless before then) ──────────────────
# sonnet     — analytical strokes via headless claude -p (post-migration default)
# notebooklm — legacy path; requires notebooklm-py[browser] + login (dormant)
GANYMEDE_SUBSTRATE=sonnet

# Engine model for claude -p invocations. Pinned explicitly per invocation
# (never rely on CLI defaults — silent-routing discipline). Live-verified
# ID recorded here by SM-1.
GANYMEDE_ENGINE_MODEL=claude-sonnet-5

# Per-session cost warning threshold, USD (headless claude -p bills the
# Max plan's included monthly non-interactive cap — see plan § 4).
GANYMEDE_RUN_COST_WARN=8

# ── NotebookLM dormancy (audit-#2 reviewer catch) ───────────────────────
# Default-ON auto-relogin would spawn a `notebooklm login` attempt on every
# boot on a machine with no stored auth. Keep 0 while NotebookLM is dormant.
GANYMEDE_AUTO_RELOGIN=0

# ── Dispatcher (intent classification ONLY — closed-sphere scoped) ──────
# Primary provider for dispatch classification. deepseek | gemini.
LLM_PROVIDER=deepseek
# Paste real keys into .env (never commit). Placeholder value is treated
# as unset (milestone 50 guard).
DEEPSEEK_API_KEY=PASTE_YOUR_DEEPSEEK_KEY_HERE
GOOGLE_API_KEY=

# ── Optional overrides (defaults are sane; uncomment to tune) ────────────
# GANYMEDE_SESSION_DB=            # sessions.db path (default: data/sessions.db)
# GANYMEDE_DISABLE_SESSION_PERSISTENCE=0
# GANYMEDE_FOUNDATIONS_DIR=       # default: <repo>/docs/foundations
# GANYMEDE_CORS_ORIGINS=          # default: localhost dev origins
# GANYMEDE_CORPUS_FILES=          # SM-2+: corpus subset for leaner-corpus runs
