# Copy to .env. Every setting is optional.

# Claude Code model alias or full model ID.
GANYMEDE_ENGINE_MODEL=sonnet

# Set only when `claude` is not on PATH.
# GANYMEDE_CLAUDE_BIN=C:\\Users\\you\\bin\\claude.cmd

# Per-invocation controls.
GANYMEDE_CLAUDE_TIMEOUT=600
GANYMEDE_CLAUDE_MAX_ATTEMPTS=2

# Runtime state. Defaults are inside ganymede-backend/data (gitignored).
# GANYMEDE_SESSION_DB=C:\\path\\to\\sessions.db
# GANYMEDE_DATA_DIR=C:\\path\\to\\ganymede-data
# GANYMEDE_DISABLE_SESSION_PERSISTENCE=0

# Foundation corpus selection.
# GANYMEDE_FOUNDATIONS_DIR=C:\\path\\to\\docs\\foundations
# GANYMEDE_CORPUS_FILES=9D_Framework_Whitepaper.md,ROEM_Formal_Model.md

# Browser access. Localhost origins are allowed by default. LAN access is
# opt-in by setting an explicit origin or regular expression.
# GANYMEDE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# GANYMEDE_CORS_ORIGIN_REGEX=

# Advanced compatibility tuning. Keep the defaults unless a measured test
# demonstrates a reason to change them.
# GANYMEDE_LOG_LEVEL=INFO
# GANYMEDE_S1_INJECTION_BUDGET=1800
# GANYMEDE_S2_INJECTION_BUDGET=1500
# GANYMEDE_S2_AUDITOR_BUDGET=900
# GANYMEDE_S2_BRIDGE_BUDGET=600
# GANYMEDE_SYNTHESIS_PACKETS_BUDGET=4500
# GANYMEDE_TRANSLATION_PROMPT_BUDGET=4800
# GANYMEDE_RESOLUTION_STABLE_THRESHOLD=0.85
